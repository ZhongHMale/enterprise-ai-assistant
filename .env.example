# ===== 企业智能助手项目配置（企业版）=====
# 用法：复制本文件为 .env，填入真实值。

# ---------- LLM（大语言模型）----------
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=你的deepseek密钥写在这里

# ---------- Embedding（向量化模型）----------
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=你的硅基流动密钥写在这里
EMBEDDING_DIM=1024   # 必须和 embedding 模型输出维度一致（bge-m3=1024）

# ---------- Rerank 重排序（可选）----------
USE_RERANK=1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_BASE_URL=https://api.siliconflow.cn/v1/rerank

# ---------- 混合检索（向量 + BM25 关键词 → RRF 融合）----------
USE_HYBRID=1

# ---------- 数据库（PostgreSQL + pgvector，企业版）----------
# 对应 docker-compose.yml 里的配置
# 注意：+psycopg = 用 psycopg3 驱动（不要删）
DATABASE_URL=postgresql+psycopg://ai:ai123456@localhost:5432/ai_assistant

# ---------- 鉴权（JWT，企业版）----------
JWT_SECRET=改成一段很长的随机字符串，生产环境务必更换
JWT_EXPIRE_MINUTES=1440

# 初始管理员（服务启动时自动创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---------- 日志 ----------
LOG_LEVEL=INFO

# ---------- LangSmith 可观测性（可选）----------
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=你的langsmith密钥（可留空）
LANGCHAIN_PROJECT=ai-assistant

# ---------- Docker Compose 专用：数据库数据存哪（可选）----------
# 作用：docker compose 会自动读本文件的变量，替换 docker-compose.yml 里的 ${PGDATA_DIR}
# 不填 → 默认存项目内 ./pgdata（开箱即用，新手推荐）
# 填了 → 存到你指定的项目外目录，实现"代码与数据分离"（生产做法）
# 注意：Windows 路径要用正斜杠 / ，不要用反斜杠 \
#   Windows 示例：PGDATA_DIR=D:/my-data/pgdata
#   Linux/Mac 示例：PGDATA_DIR=/data/pgdata
# PGDATA_DIR=./pgdata
